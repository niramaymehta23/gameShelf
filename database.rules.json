{
  "rules": {
    "presence": {
      "$code": {
        ".read": "$code.matches(/^[A-Z]{4}$/)",
        "$id": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": "newData.child('at').isNumber()",
          "at": { ".validate": true },
          "pres": {
            "seat": { ".validate": "newData.isString()" },
            "screen": { ".validate": "newData.isString() && newData.val().length < 40" },
            "hover": { ".validate": "newData.isNumber()" },
            "aim": { ".validate": "newData.hasChildren(['0', '1'])" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
