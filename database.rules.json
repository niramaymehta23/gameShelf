{
  "rules": {
    "presence": {
      "$code": {
        ".read": "$code.matches(/^[A-Z]{4}$/)",
        "$id": {
          ".write": "$code.matches(/^[A-Z]{4}$/)",
          ".validate": "newData.child('at').isNumber()",
          "at": {
            ".validate": true
          },
          "pres": {
            "seat": {
              ".validate": "newData.isString()"
            },
            "screen": {
              ".validate": "newData.isString() && newData.val().length < 40"
            },
            "hover": {
              ".validate": "newData.isNumber()"
            },
            "aim": {
              ".validate": "newData.hasChildren(['0', '1'])"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "chat": {
      "$code": {
        ".read": "$code.matches(/^[A-Z]{4}$/)",
        ".indexOn": [
          "at"
        ],
        "$id": {
          ".write": "$code.matches(/^[A-Z]{4}$/) && (!data.exists() || !newData.exists())",
          ".validate": "newData.hasChildren(['seat', 'at']) && newData.child('at').val() === now && newData.hasChild('e') !== newData.hasChild('t')",
          "seat": {
            ".validate": "newData.val() === 'host' || newData.val() === 'guest'"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "e": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
          },
          "t": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
